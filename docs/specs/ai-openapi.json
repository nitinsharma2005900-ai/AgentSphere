      "post": {
        "tags": [
          "Prompt Regression & CI/CD Evaluations"
        ],
        "summary": "Run Evaluation Suite",
        "operationId": "run_evaluation_suite_api_v1_evaluations_run_post",
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "mock",
              "title": "Provider"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
