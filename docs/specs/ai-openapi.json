  "components": {
    "schemas": {
      "Body_upload_and_index_document_api_v1_documents_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          }
        },
        "type": "object",
        "required": [
          "file",
          "tenant_id"
        ],
        "title": "Body_upload_and_index_document_api_v1_documents_upload_post"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 40,
            "minItems": 1,
            "title": "Messages"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "system_instruction": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 24000
              },
              {
                "type": "null"
              }
            ],
            "title": "System Instruction"
          },
          "temperature": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Temperature",
            "default": 0.7
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 2048
          },
          "tools": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ToolDefinition"
                },
                "type": "array",
                "maxItems": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Tools"
          },
          "response_schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Schema"
          },
          "tenant_id": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Tenant Id"
          }
        },
        "type": "object",
        "required": [
          "messages",
          "tenant_id"
        ],
        "title": "ChatRequest"
      },
      "ExecutionUsage": {
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "title": "Prompt Tokens",
            "default": 0
          },
          "completion_tokens": {
            "type": "integer",
            "title": "Completion Tokens",
            "default": 0
          },
          "total_tokens": {
            "type": "integer",
            "title": "Total Tokens",
            "default": 0
          },
          "estimated_cost_usd": {
            "type": "number",
            "title": "Estimated Cost Usd",
            "default": 0.0
          }
        },
        "type": "object",
        "title": "ExecutionUsage"
      },
      "GenerationResponse": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content"
          },
          "tool_calls": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ToolCall"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Calls"
          },
          "finish_reason": {
            "type": "string",
            "title": "Finish Reason",
            "default": "stop"
          },
          "usage": {
            "$ref": "#/components/schemas/ExecutionUsage"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "default": false
          },
          "is_fallback": {
            "type": "boolean",
            "title": "Is Fallback",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "content",
          "provider",
          "model"
        ],
        "title": "GenerationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestionResponse": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "file_type": {
            "type": "string",
            "title": "File Type"
          },
          "total_chunks": {
            "type": "integer",
            "title": "Total Chunks"
          },
          "total_characters": {
            "type": "integer",
            "title": "Total Characters"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "indexed"
          },
          "tenant_id": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Tenant Id"
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "filename",
          "file_type",
          "total_chunks",
          "total_characters",
          "tenant_id"
        ],
        "title": "IngestionResponse"
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "SearchResult": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "similarity_score": {
            "type": "number",
            "title": "Similarity Score"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "content",
          "similarity_score",
          "metadata"
        ],
        "title": "SearchResult"
      },
      "SemanticSearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Query"
          },
          "tenant_id": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Tenant Id"
          },
          "top_k": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 4
          },
          "min_similarity": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Min Similarity",
            "default": 0.05
          },
          "filter_doc_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filter Doc Ids"
          }
        },
        "type": "object",
        "required": [
          "query",
          "tenant_id"
        ],
        "title": "SemanticSearchRequest"
      },
      "ToolCall": {
        "properties": {
          "tool_name": {
            "type": "string",
            "title": "Tool Name"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments"
          }
        },
        "type": "object",
        "required": [
          "tool_name",
          "arguments"
        ],
        "title": "ToolCall"
      },
      "ToolDefinition": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "title": "ToolDefinition"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}