# ==============================================================================
# AgentSphere Enterprise Configuration (.env.example)
# ==============================================================================

# Node.js Express Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your-32-character-secret-key-for-jwt-signing!
JWT_REFRESH_SECRET=your-32-character-secret-key-for-refresh-tokens!
CORS_ORIGIN=*

# AI Model Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# AI Service Gateway
AI_SERVICE_URL=http://localhost:8000/api/v1
AI_SERVICE_PORT=8000

# Database Configuration (PostgreSQL + pgvector)
# Example: postgres://username:password@localhost:5432/agentsphere_db
DATABASE_URL=

# Caching & Background Jobs (Redis)
# Example: redis://localhost:6379
REDIS_URL=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
